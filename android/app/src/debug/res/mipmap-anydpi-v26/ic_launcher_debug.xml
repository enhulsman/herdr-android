<?xml version="1.0" encoding="utf-8"?>
<!-- The debug build's icon: the release icon inverted (the ear tag as a
     graphite outline on tag yellow), so "Kudde debug" looks finished on the
     phone yet never passes for the release. Monochrome: the same outline, for
     themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_debug_background" />
    <foreground android:drawable="@drawable/ic_launcher_debug_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_debug_foreground" />
</adaptive-icon>
