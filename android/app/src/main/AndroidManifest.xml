<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- On GrapheneOS, Network is a per-app runtime permission that can come up
         off after an update; the app reports "Network permission is off". -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- BiometricPrompt throws SecurityException without it. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Alerts (M3): asked for when alerts are turned on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the hourly "Alert health" check scheduled across reboots. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".HerdrApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="${appIcon}"
        android:label="${appLabel}"
        android:roundIcon="${appIcon}"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- Resizes for the keyboard on every screen; each screen pads for it (issue 5). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- An agent notification's tap: only the app's own notifications can start it. -->
        <activity
            android:name=".push.AlertTapActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Started by the UnifiedPush distributor (ntfy), also with the app closed. -->
        <service
            android:name=".push.HerdrPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".push.SilenceCheckService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>
