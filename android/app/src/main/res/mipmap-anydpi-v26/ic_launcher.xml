<?xml version="1.0" encoding="utf-8"?>
<!-- The release build's icon: the lit ear tag on graphite (debug has it
     inverted in src/debug/res and spike keeps the system default, so they are
     easy to tell apart). Monochrome: the flat tag, for Android's themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
