<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The system prompt that opens the SSH key's 30-minute window. -->
    <string name="unlock_key_title">Unlock the SSH key</string>
    <string name="unlock_key_subtitle">To connect to your machines</string>

    <!-- Machines screen (render 7). -->
    <string name="back">Back</string>
    <string name="machines_title">Machines</string>
    <string name="machines_empty">Add a machine that runs herdr-core to see its agents here.</string>
    <string name="machines_add">Add machine</string>
    <string name="machines_this_phone">This phone</string>
    <string name="machines_phone_key">Phone key</string>
    <!-- The key accepts a strong biometric or the device credential, for 30 minutes (AndroidKeystoreBackend). -->
    <string name="machines_phone_key_detail">Needs your fingerprint or screen lock, then valid 30 min</string>
    <string name="machines_export">Export machine list</string>
    <string name="machines_export_detail">Without keys</string>

    <!-- A machine's status line: parts joined by status_separator. -->
    <string name="status_separator">" · "</string>
    <string name="status_paused">Paused</string>
    <string name="status_connecting">Connecting</string>
    <string name="status_connected">Connected</string>
    <string name="status_core_version">herdr-core %1$s</string>
    <string name="status_untested">untested version</string>
    <string name="status_unreachable">Unreachable</string>
    <!-- %1$s is one of the status_ago_* strings. -->
    <string name="status_last_connected">last connected %1$s</string>
    <string name="status_ago_now">just now</string>
    <string name="status_ago_minutes">%1$dm ago</string>
    <string name="status_ago_hours">%1$dh ago</string>
    <string name="status_ago_days">%1$dd ago</string>
    <string name="status_retrying">retrying</string>
    <string name="status_needs_user_auth">Phone key locked</string>
    <string name="status_host_key_unconfirmed">Host key not confirmed yet</string>
    <string name="status_host_key_changed">Host key changed</string>
    <string name="status_not_connecting">not connecting</string>
    <string name="status_key_rejected">Phone key not accepted</string>
    <!-- Wording from the machine-connection spec ("herdr-core missing", "Older core"). -->
    <string name="status_not_installed">herdr-core not found on this machine</string>
    <string name="status_too_old">herdr-core %1$s is older than this app supports</string>
    <string name="status_too_old_detail">Update it to %1$s or newer, then try again.</string>
    <string name="status_app_too_old">This app is too old for this machine\'s herdr-core</string>
    <string name="status_app_too_old_detail">Update the app to connect.</string>
    <!-- decisions.md 2026-11-01: GrapheneOS's per-app Network permission. -->
    <string name="status_network_off">Network permission is off</string>
    <string name="status_network_off_detail">Allow Network for herdr in Android settings.</string>

    <!-- What a machine card offers when it waits for the person. -->
    <string name="action_unlock">Unlock</string>
    <string name="action_try_again">Try again</string>
    <string name="link_check_host_key">Check the host key</string>
    <string name="link_check_host_key_detail">Connects once you trust its fingerprint</string>
    <string name="link_compare_host_keys">Compare the host keys</string>
    <string name="link_compare_host_keys_detail">The machine shows a different key than the one you trusted</string>
    <string name="link_add_phone_key">Add the phone key</string>
    <string name="link_add_phone_key_detail">One line for this machine\'s authorized_keys</string>
    <!-- Add machine (render 8 shows Name and Host; the rest follows its style). -->
    <string name="add_title">Add machine</string>
    <string name="field_name">Name</string>
    <string name="field_host">Host</string>
    <string name="field_port">Port</string>
    <string name="field_user">User</string>
    <!-- machine-connection spec: OpenSSH only; Tailscale SSH ignores authorized_keys. -->
    <string name="add_note">The machine needs an OpenSSH server. Tailscale SSH ignores the phone key.</string>
    <string name="add_save">Add machine</string>
    <!-- %1$s is host:port. -->
    <string name="add_waiting">Connecting to %1$s…</string>
    <string name="error_name_required">Give the machine a name.</string>
    <!-- %1$s is the name typed. -->
    <string name="error_name_taken">There is already a machine called %1$s.</string>
    <string name="error_name_too_long">Use at most 64 characters.</string>
    <string name="error_name_one_line">Keep the name on one line.</string>
    <string name="error_host_required">Enter the machine\'s host name or address.</string>
    <string name="error_host_invalid">Use a host name or address without spaces.</string>
    <string name="error_port_invalid">Use a port from 1 to 65535.</string>
    <string name="error_user_required">Enter the user you sign in as on that machine.</string>
    <string name="error_user_invalid">Use the login name only, without spaces or @.</string>

    <!-- First connection: the host-key confirm (render 8). %1$s is host:port, drawn in the text colour. -->
    <string name="trust_title">Trust this machine?</string>
    <string name="trust_body">First connection to %1$s. Check that this fingerprint matches the machine\'s host key.</string>
    <string name="trust_after">After this, a different key stops the connection.</string>
    <string name="cancel">Cancel</string>
    <string name="trust_confirm">Trust and connect</string>

    <!-- A changed host key (no render; machine-connection spec "Host key changed"). -->
    <string name="changed_title">Host key changed</string>
    <!-- %1$s is the machine's name, drawn in the text colour. -->
    <string name="changed_body">%1$s showed a different host key than the one you trusted, so the app stopped connecting to it.</string>
    <string name="changed_trusted">Trusted key</string>
    <string name="changed_presented">Key it shows now</string>
    <string name="changed_why">This is expected after the machine was reinstalled or got new SSH host keys. Otherwise something may be intercepting the connection: check the new fingerprint on the machine itself first.</string>
    <string name="changed_forget">Forget this machine\'s key</string>
    <string name="forget_title">Forget the trusted key?</string>
    <!-- %1$s is the machine's name. -->
    <string name="forget_body">The app stops trusting %1$s\'s old key. On the next connection it shows the new fingerprint and connects only after you trust it.</string>
    <string name="forget_confirm">Forget key</string>

    <!-- The phone key line (no render). -->
    <string name="phone_key_title">Phone key</string>
    <!-- %1$s is the machine's name, drawn in the text colour. -->
    <string name="phone_key_where_machine">Add this line to ~/.ssh/authorized_keys of the user you sign in as on %1$s.</string>
    <string name="phone_key_where_any">Add this line to ~/.ssh/authorized_keys of the user you sign in as on each machine.</string>
    <string name="phone_key_restricted">With this key, SSH runs only herdr-core: no terminal session, no forwarding. herdr-core can still run commands as this user, so treat the key like a shell login.</string>
    <string name="phone_key_copy">Copy</string>
    <string name="phone_key_copied">Copied</string>
    <!-- The clipboard entry's label (ClipData), shown by some keyboards. -->
    <string name="phone_key_clip_label">authorized_keys line</string>
    <!-- %1$s is why, from KeyManager. -->
    <string name="phone_key_unavailable">The phone key is not available: %1$s</string>
</resources>
