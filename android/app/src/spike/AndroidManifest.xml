<?xml version="1.0" encoding="utf-8"?>
<!-- The spike build type opens straight into the terminal spike (task M0.5).
     The key spike (task M0.6) is started over adb with the server as extras;
     the push spike (task M0.7) over adb too. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <activity
            android:name=".MainActivity"
            tools:node="remove" />
        <!-- One PUSH_EVENT receiver per app: the spike keeps its own. -->
        <service
            android:name=".push.HerdrPushService"
            tools:node="remove" />
        <activity
            android:name=".spike.SpikeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".spike.KeySpikeActivity"
            android:exported="true" />
        <activity
            android:name=".spike.PushSpikeActivity"
            android:exported="true" />
        <service
            android:name=".spike.SpikePushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
