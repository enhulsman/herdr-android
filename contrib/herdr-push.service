# systemd user unit for herdr-push (docs/herdr-push.md).
# Install: cp herdr-push.service ~/.config/systemd/user/ && systemctl --user enable --now herdr-push
[Unit]
Description=herdr-push: phone alerts for herdr agents

[Service]
ExecStart=%h/.local/bin/herdr-push
# A missing core or a config mistake is logged and retried, never fatal.
Restart=always
RestartSec=60
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
