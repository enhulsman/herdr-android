{
  "name": "kudde-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The kudde.dev website: static pages built with Astro.",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "ASTRO_TELEMETRY_DISABLED=1 astro build && node --test tests/site.test.mjs"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "playwright": "1.55.1",
    "wrangler": "4.158.0"
  }
}
