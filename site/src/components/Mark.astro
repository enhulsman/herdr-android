---
// The colour A1 mark: flat tag yellow with the ink prompt.
import { TAG, HOLE, PROMPT } from '../lib/tag.js';
interface Props { size?: number; class?: string }
const { size = 34, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" focusable="false">
  <path style="fill:var(--color-tag)" fill-rule="evenodd" d={`${TAG}${HOLE}`} />
  <path d={PROMPT} fill="none" style="stroke:var(--color-ink)" stroke-width="5.4" stroke-linecap="round" stroke-linejoin="round" />
</svg>
